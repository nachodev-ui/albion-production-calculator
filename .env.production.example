# Reemplaza el dominio por la API central real antes del deploy.
VITE_CENTRAL_MARKET_API_URL=https://api.example.com/api/v1

# Los builds públicos nunca deben consultar un receiver local.
VITE_ENABLE_LOCAL_RECEIVER_FALLBACK=false

VITE_MARKET_REQUEST_TIMEOUT_MS=7000

# No agregues secretos, tokens ni credenciales a variables VITE_*.
