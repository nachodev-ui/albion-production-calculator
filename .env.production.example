# API central pública desplegada en Fly.io São Paulo.
VITE_CENTRAL_MARKET_API_URL=https://albion-market-api-nachodev.fly.dev/api/v1

# Los builds públicos nunca consultan un receiver local.
VITE_ENABLE_LOCAL_RECEIVER_FALLBACK=false

VITE_MARKET_REQUEST_TIMEOUT_MS=7000

# No agregues secretos, tokens ni credenciales a variables VITE_*.
