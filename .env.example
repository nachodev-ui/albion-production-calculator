# API central de lectura.
# En desarrollo puede apuntar a localhost. Todo build de producción exige HTTPS.
VITE_CENTRAL_MARKET_API_URL=http://127.0.0.1:8080/api/v1

# Modo avanzado para desarrollo o diagnóstico de colaboradores.
# Debe permanecer en false para producción y previews públicos.
VITE_ENABLE_LOCAL_RECEIVER_FALLBACK=false

# Receiver local. Solo se consulta cuando el fallback local está habilitado.
# Puede usar HTTP únicamente en localhost/127.0.0.1.
VITE_LOCAL_MARKET_API_URL=http://127.0.0.1:8787/api/v1

# Alias legado para instalaciones antiguas.
# Preferir VITE_LOCAL_MARKET_API_URL en configuraciones nuevas.
# VITE_MARKET_API_URL=http://127.0.0.1:8787/api/v1

# Timeout de requests de mercado.
# Rango permitido: 1000-30000.
VITE_MARKET_REQUEST_TIMEOUT_MS=7000

# Auth0 SPA. Estos identificadores son públicos y forman parte del bundle.
# Mantener false en desarrollo hasta configurar también la API local.
VITE_AUTH0_ENABLED=false
VITE_AUTH0_DOMAIN=albion-production-calculator.us.auth0.com
VITE_AUTH0_CLIENT_ID=4Bhvhd3PcxNwmMyvK5ocLi9Q33hHr74y
VITE_AUTH0_AUDIENCE=https://albion-market-api
VITE_AUTH0_SCOPE=openid profile email offline_access read:account

# Persistencia de sesión para evitar solicitar un nuevo inicio de sesión al
# recargar. localstorage requiere una CSP estricta y no sustituye el logout.
VITE_AUTH0_CACHE_LOCATION=localstorage
VITE_AUTH0_USE_REFRESH_TOKENS=true
VITE_AUTH0_USE_REFRESH_TOKENS_FALLBACK=true

# Habilita botones que redirigen al checkout y portal alojados. No contiene
# secretos, pero debe permanecer false hasta activar BILLING_ENABLED en la API.
VITE_BILLING_ENABLED=false

# Nunca agregar secretos, tokens, client secrets ni credenciales con prefijo VITE_.
