{
  "name": "albion-craft-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-seo-assets.mjs --public",
    "dev": "vite",
    "prebuild": "node scripts/generate-seo-assets.mjs --public",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/generate-seo-assets.mjs --dist",
    "seo:generate": "node scripts/generate-seo-assets.mjs",
    "indexnow:check": "node scripts/check-indexnow-config.mjs && node scripts/submit-indexnow.mjs --dry-run",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:dataset": "tsx scripts/generate-dataset.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "contracts:lint": "redocly lint contracts/central-api/openapi.yaml contracts/local-receiver/openapi.json",
    "contracts:generate": "openapi-typescript contracts/central-api/openapi.yaml -o src/shared/contracts/central-api.generated.ts && openapi-typescript contracts/local-receiver/openapi.json -o src/shared/contracts/local-receiver.generated.ts",
    "contracts:compat": "tsx scripts/check-market-contracts.ts",
    "contracts:check": "pnpm contracts:lint && pnpm contracts:generate && pnpm contracts:compat && git diff --exit-code -- src/shared/contracts",
    "security:check": "tsx scripts/check-public-security.ts && pnpm indexnow:check",
    "auth0:check": "tsx scripts/validate-auth0-production.ts",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "bundle:analyze": "pnpm build && tsx scripts/check-bundle-budget.ts --write-report"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@redocly/cli": "2.36.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-xml-parser": "^5.9.3",
    "globals": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
