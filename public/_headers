/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https:; form-action 'none'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https:; worker-src 'self' blob:; manifest-src 'self';

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

https://albion-production-calculator.pages.dev/*
  X-Robots-Tag: noindex, nofollow
  Link: <https://albioncalculator.app/:splat>; rel="canonical"

https://:version.albion-production-calculator.pages.dev/*
  X-Robots-Tag: noindex, nofollow
  Link: <https://albioncalculator.app/:splat>; rel="canonical"

https://www.albioncalculator.app/*
  X-Robots-Tag: noindex, follow
  Link: <https://albioncalculator.app/:splat>; rel="canonical"

/refining
  X-Robots-Tag: noindex, nofollow

/presets
  X-Robots-Tag: noindex, nofollow

/account
  X-Robots-Tag: noindex, nofollow

/profile
  X-Robots-Tag: noindex, nofollow

/admin
  X-Robots-Tag: noindex, nofollow
